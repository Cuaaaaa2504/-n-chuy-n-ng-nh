# ============================================================
# recommendation-service — file mẫu biến môi trường
# Các DB_* còn thiếu sẽ tự kế thừa từ .env của NestJS.
# ============================================================

# Chỉ lắng nghe máy local theo mặc định. Đổi thành 0.0.0.0 khi chạy container
# và đã có firewall/reverse proxy phù hợp.
HOST=127.0.0.1
PORT=8000

# Dùng cùng giá trị với RECOMMENDATION_ADMIN_TOKEN của backend.
RECOMMENDATION_ADMIN_TOKEN=thay_bang_chuoi_ngau_nhien_dai

# Tuỳ chọn: ghi đè đường dẫn .env backend nếu cấu trúc repo khác.
# BACKEND_ENV_PATH=/duong/dan/cinehunt-backend/.env

# Chỉ khai báo DB_* tại đây khi Python thật sự dùng cấu hình khác NestJS.
# DB_HOST=localhost
# DB_PORT=1433
# DB_USERNAME=sa
# DB_PASSWORD=doi_mat_khau_cua_ban
# DB_DATABASE=CineHuntDB
# DB_INSTANCE=SQLEXPRESS

# pyodbc hoặc pymssql. config.py tự dò Driver 18/17 và fallback pymssql.
DB_CONNECTOR=pyodbc
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

MODEL_DIR=model
MODEL_FILE=recommender.joblib
MODEL_VERSION=v7-hybrid
WEIGHT_SVD=0.6
WEIGHT_CONTENT=0.3
WEIGHT_POPULARITY=0.1
SVD_COMPONENTS=50
TOP_N_CACHE=30
POSITIVE_BOOKING_STATUSES=PAID,ISSUED

AUTO_TRAIN_ON_START=false
TRAIN_TIMEOUT_SECONDS=1800
