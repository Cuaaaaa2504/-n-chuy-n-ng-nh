# ============================================================
# recommendation-service — file mẫu biến môi trường
# Copy thành .env:   cp .env.example .env   (Windows: copy .env.example .env)
# KHÔNG commit file .env.
# ============================================================

# --- HTTP ----------------------------------------------------
HOST=0.0.0.0
# PHẢI khớp với RECOMMENDATION_SERVICE_URL trong .env của cinehunt-backend.
PORT=8000

# --- Database (dùng chung DB với NestJS, chỉ đọc) ------------
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=doi_mat_khau_cua_ban
DB_DATABASE=CineHuntDB

# Chỉ điền khi SQL Server cài dạng named instance (VD: SQLEXPRESS).
# Khi có DB_INSTANCE thì DB_PORT bị bỏ qua (SQL Browser tự phân giải cổng).
# DB_INSTANCE=SQLEXPRESS

# pyodbc (mặc định) hoặc pymssql nếu máy không cài được ODBC Driver.
DB_CONNECTOR=pyodbc
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- Model ---------------------------------------------------
MODEL_DIR=model
MODEL_FILE=recommender.joblib
MODEL_VERSION=v7-hybrid

# Trọng số Hybrid — đúng BEST_HYBRID_WEIGHTS của notebook v7.
WEIGHT_SVD=0.6
WEIGHT_CONTENT=0.3
WEIGHT_POPULARITY=0.1

# Số chiều tiềm ẩn của SVD. Tự động giảm nếu DB có ít phim/user hơn.
SVD_COMPONENTS=50

# Số phim lưu cache cho mỗi user trong bảng movie_recommendations.
TOP_N_CACHE=30

# Trạng thái đơn được tính là "đã xem".
POSITIVE_BOOKING_STATUSES=PAID,ISSUED
