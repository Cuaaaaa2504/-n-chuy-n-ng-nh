# compiled output
/dist
/node_modules

# FIX [#4]: build cache của TypeScript (~280KB), sinh lại mỗi lần `nest build`.
# Commit vào Git chỉ làm nặng repo và gây noise trong git diff.
# Nếu file đã lỡ được commit, chạy 1 lần:
#   git rm --cached tsconfig.tsbuildinfo
*.tsbuildinfo

# File người dùng upload lúc runtime — không phải source code.
# Giữ lại .gitkeep để thư mục vẫn tồn tại sau khi clone.
/uploads/**/*
!/uploads/**/.gitkeep

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json

# Environment
.env
.env.local
.env.*.local
