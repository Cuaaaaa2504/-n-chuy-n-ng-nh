# ============================================================
# CineHunt Backend — file mẫu biến môi trường
# Copy thành .env rồi điền giá trị thật: cp .env.example .env
# TUYỆT ĐỐI KHÔNG commit file .env lên Git.
# ============================================================

NODE_ENV=development

# --- Database ------------------------------------------------
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=doi_mat_khau_cua_ban
DB_DATABASE=CineHuntDB
# DB_INSTANCE=SQLEXPRESS
# Local SQL Server thường false/true; Azure SQL phải true/false.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Dev mặc định chạy migration; production mặc định không chạy nếu bỏ biến này.
DB_MIGRATIONS_RUN=true

# --- Server --------------------------------------------------
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# --- JWT -----------------------------------------------------
JWT_SECRET=thay_bang_chuoi_ngau_nhien_du_dai
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=thay_bang_chuoi_ngau_nhien_khac
JWT_REFRESH_EXPIRES_IN=7d

# Dùng chuỗi riêng, ngẫu nhiên, tối thiểu 32 byte để HMAC mã OTP.
OTP_HASH_SECRET=thay_bang_chuoi_ngau_nhien_rieng_cho_otp
# Chỉ bật tạm ở local khi chưa tích hợp email/SMS. Production luôn để false.
OTP_EXPOSE_CODE_IN_DEV=false

# --- Gemini AI -----------------------------------------------
# Lấy key từ Google AI Studio. Không commit key thật.
GEMINI_API_KEY=
# Gemini 2.0 Flash đã ngừng hoạt động từ 01/06/2026.
GEMINI_MODEL=gemini-3.6-flash

# --- Groq AI fallback ----------------------------------------
# Khi Gemini trả 429, backend tự chuyển sang Groq.
# Lấy key trong Groq Console -> API Keys. Không commit key thật.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Rate limit ----------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Recommendation service ----------------------------------
RECOMMENDATION_SERVICE_URL=http://localhost:8000
RECOMMENDATION_TIMEOUT_MS=5000

# Chỉ đặt khi recommendation-service không nằm ở root repository.
# RECOMMENDATION_SERVICE_DIR=/duong/dan/recommendation-service
PYTHON_BIN=python3
RECOMMENDATION_HOST=127.0.0.1
RECOMMENDATION_PORT=8000

# start:stack tự train lần đầu nếu chưa có model.
RECOMMENDATION_BOOTSTRAP_MODEL=true

# Scheduler train lúc 03:00; production mặc định tắt nếu bỏ cả hai biến.
RECOMMENDATION_TRAIN_ENABLED=true
# Tên cũ vẫn được scheduler hỗ trợ để tương thích.
RECOMMENDATION_AUTO_TRAIN=true


# Chỉ bật cho demo local. Production phải false.
ALLOW_DEMO_PAYMENT=false

# lax khi frontend/API cùng site; none khi thật sự khác site (bắt buộc HTTPS).
REFRESH_COOKIE_SAME_SITE=lax
