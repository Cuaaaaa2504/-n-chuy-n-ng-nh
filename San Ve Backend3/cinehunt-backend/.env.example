# ============================================================
# CineHunt Backend — file mẫu biến môi trường
# Copy thành .env rồi điền giá trị thật:  cp .env.example .env
# TUYỆT ĐỐI KHÔNG commit file .env lên Git.
# ============================================================

# --- Database (5 biến bắt buộc) ------------------------------
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=doi_mat_khau_cua_ban
DB_DATABASE=CineHuntDB

# Chỉ điền khi SQL Server cài dạng named instance.
# VD kết nối SSMS là "MAYTINH\SQLEXPRESS" thì điền SQLEXPRESS.
# Không dùng thì để trống hoặc xoá hẳn dòng này.
# DB_INSTANCE=SQLEXPRESS

# --- Server --------------------------------------------------
PORT=3000

# Danh sách origin của frontend, phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# --- JWT -----------------------------------------------------
# Sinh chuỗi ngẫu nhiên đủ dài, KHÔNG dùng lại giá trị mẫu này.
# Gợi ý:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay_bang_chuoi_ngau_nhien_du_dai
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=thay_bang_chuoi_ngau_nhien_khac
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate limit toàn cục (lưới an toàn) ----------------------
# ttl tính bằng giây. Route nhạy cảm tự siết chặt hơn bằng @Throttle().
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Service gợi ý phim (Python) -----------------------------
RECOMMENDATION_SERVICE_URL=http://localhost:8000
RECOMMENDATION_TIMEOUT_MS=5000
